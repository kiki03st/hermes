# ~/.hermes/.env 에 복사해서 값 채우기.
# 실제 키/스키마는 hermes-agent 공식 문서로 확인함:
# https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/features/api-server.md
#
# env 값은 config.yaml의 같은 설정보다 항상 우선한다.
# 각 키를 어디서 발급받고 왜 필요한지는 docs/hermes-credentials.md 참고.

# --- LLM 프로바이더 (Anthropic 또는 OpenRouter 중 택1, Hermes 표준 설정) ---
# Anthropic은 OAuth(hermes model)로도 되지만 Claude Max + 추가 사용량 크레딧이 있어야 동작함.
# Claude Pro는 OAuth 경로 자체가 막혀 있어 이 키가 필수 (docs/hermes-credentials.md 참고).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- API 서버 (Stage 0) ---
# 기본값: ENABLED=false, PORT=8642, HOST=127.0.0.1(로컬만) — 폰에서 붙으려면 HOST를 0.0.0.0으로.
API_SERVER_ENABLED=true
API_SERVER_KEY=change-me-generate-a-long-random-string
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# 브라우저에서 직접 호출할 때만 필요 (폰 네이티브 앱은 불필요)
# API_SERVER_CORS_ORIGINS=http://localhost:3000

# --- 웹 검색 백엔드 (Hermes 내장, 여러 종 중 택1 — 키 이름 정확히 맞출 것) ---
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=   (⚠️ BRAVE_API_KEY 아님)
# FIRECRAWL_API_KEY=      (기본값 — 키 없이도 일부 동작)

# --- 이미지 생성 (Hermes 내장, 선택) ---
# env에 키만 넣는다고 안 됨 — `hermes tools`로 image_gen.provider를 명시적으로 선택해야 반영됨.
# FAL_KEY=

# --- google-calendar-mcp (Stage 0, vendor/google-calendar-mcp) ---
# OAuth 클라이언트 JSON 경로. Google Cloud Console에서 OAuth 클라이언트(데스크톱 앱) 생성 후 다운로드.
# GOOGLE_OAUTH_CREDENTIALS=D:\hermes-projects\secrets\gcp-oauth.keys.json
