# ~/.hermes/config.yaml 에 병합할 mcp_servers 블록.
# (Windows 실제 경로: %LOCALAPPDATA%\hermes\config.yaml — windows-migration.md §7.3)
#
# 스키마는 hermes-agent 공식 문서로 확인함:
# https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/features/mcp.md
# (stdio: command/args/env/cwd/connect_timeout, 공통: enabled/lazy/trust/tools.include|exclude —
#  실제로 읽히는 키는 소스로 재확인함, windows-migration.md §7.5)
#
# 각 서버의 command/args 경로(C:\hermes-projects\vendor\...)는 실제 설치 위치에 맞게 바꾼다.
# vendor/README.md 에 각 MCP의 클론 시점·소스·실측 정정 사항이 정리되어 있다.

mcp_servers:
  # --- AutoCAD 2D 작도 (CAD-MCP) ---
  # daobataotie/CAD-MCP — 실제 도구 11개(process_command 포함) 중 10개만 노출.
  # process_command는 자연어를 정규식+이중언어 키워드 파서로 10개 도형 명령에 매핑할 뿐이다
  # (SendCommand 비동기/레이스라는 원안 근거는 사실이 아니었다 — vendor/README.md 실측 정정).
  # 차단은 유지: LLM이 이미 하는 의도 해석을 정규식 파서가 중복하며 오파싱 위험만 더한다.
  acad2d:
    command: "python"
    args: ["C:\\hermes-projects\\vendor\\CAD-MCP\\src\\server.py"]
    tools:
      exclude: ["process_command"]

  # --- AutoCAD 조회·수정·캡처·내보내기·승인 게이트 (mcp-acad-assist, 이 리포 신규 구현) ---
  #
  # ⚠️ 같은 서버(`acad-assist` 콘솔 스크립트)를 아래 세 이름(acad-read/acad-write/
  # cad-pipeline)으로 **여러 번 등록**한다. 이유(2026-08-28 실측, windows-migration.md
  # §7 참고): Hermes v0.20.6의 MCP 트러스트
  # 게이트(`tools/mcp_tool.py`)는 도구의 `annotations.readOnlyHint`를 봐서 승인 없이
  # 실행해도 되는 도구를 가려내야 하는데, 그 코드가 `getattr(annotations, "readOnlyHint")`로
  # 읽는 반면 mcp SDK(2.1.1)의 실제 파이썬 필드명은 `read_only_hint`다 — live discovery
  # 경로에서는 이 값이 절대 안 읽힌다(server.py의 test_hermes_readonlyhint_bug_regression이
  # 이 서버 자신의 객체로 고정해 둔 회귀 테스트). 그래서 어노테이션에 의존하지 않고
  # **서버 단위**로 trust 를 나눈다 — 이건 그 버그와 무관하게 확실히 동작한다.
  #
  # `pip install -e mcp-acad-assist` 로 설치하면 콘솔 스크립트 acad-assist가 PATH에 등록된다.
  # HERMES_CAD_ROOT 는 mcp-acad-assist/src/acad_assist/projects.py 가 읽는 파이프라인 루트다
  # — 하드코딩된 C:\hermes-projects 가 아니라 이 env 로 주입한다(이식성).
  acad-read:                          # status/query/get/purge_check/capture — 승인 불필요
    command: "acad-assist"
    trust: full
    env:
      HERMES_CAD_ROOT: "C:\\hermes-projects"
    tools:
      include: ["status", "query", "get", "purge_check", "capture"]

  acad-write:                         # modify/layer/export — 호출마다 폰에 승인 요청
    command: "acad-assist"
    trust: untrusted
    env:
      HERMES_CAD_ROOT: "C:\\hermes-projects"
    tools:
      include: ["modify", "layer", "export"]

  # 같은 acad-assist 콘솔 스크립트의 세 번째 등록 — SketchUp/3ds Max 로 넘길 결정론적
  # Ruby/MAXScript **텍스트 생성기** 10개(sketchup_scripts.py/maxscripts.py). COM 을
  # 안 건드리고 부작용이 전혀 없어(문자열만 돌려준다) 전부 읽기 전용이다. 생성된
  # 텍스트는 sketchup/max3d 서버의 eval_ruby/execute_maxscript 에 한 글자도 고치지
  # 않고 그대로 넘겨야 한다 — `hermes-config/skills/cad-pipeline.md` 참고.
  cad-pipeline:
    command: "acad-assist"
    trust: full
    tools:
      include:
        - "sketchup_import_dwg_script"
        - "sketchup_extrude_walls_script"
        - "sketchup_save_skp_script"
        - "sketchup_export_fbx_script"
        - "sketchup_capture_iso_script"
        - "sketchup_unit_check_script"
        - "max_import_skp_script"
        - "max_setup_camera_script"
        - "max_setup_lighting_script"
        - "max_render_to_file_script"
        # SketchUp/Max 산출물은 Ruby/MAXScript 실행 결과라 acad-assist가 직접 못
        # 봄 — export처럼 자동 등록이 안 되니 에이전트가 성공 확인 후 이걸로 직접
        # meta.json에 등록한다(2026-08-29 추가, cad-pipeline.md 참고).
        - "register_artifact"

  # --- 3D 모델링 (SketchUp Pro) ---
  # mhyrr/sketchup-mcp.
  #
  # 실측 정정 (2026-08-28): PyPI 배포판(0.1.17, 2025-03-13)이 git HEAD보다 13개월
  # 낡았고 eval_ruby 도구가 없을 수 있다 — mcp-acad-assist의 sketchup_scripts.py가
  # 만드는 Ruby는 전부 eval_ruby 로 들어가야 하므로 `uvx sketchup-mcp`(PyPI 고정) 대신
  # 소스를 클론해서 `uv run --directory` 로 최신 코드를 쓴다. vendor/README.md 참고.
  #
  # 사전 조건: SketchUp에서 Extensions > MCP Server > Start Server
  # (자동 기동 아님, 기본 TCP 127.0.0.1:9876).
  #
  # trust:full — sketchup-mcp의 파이썬 도구(create_component 등)는 쓰지 않고 eval_ruby로만
  # 우리가 만든 결정론적 스크립트를 실행한다(생성기 방식, PLAN.md Stage 4-3). eval_ruby 자체는
  # 임의 코드 실행이라 원칙적으로 write-capable이지만, 이 파이프라인에서 그 인자는 항상
  # sketchup_scripts.py 가 생성한 문자열뿐이라 acad-write와 같은 승인 게이트를 굳이 매번
  # 거치게 하지 않았다 — 대상 환경에서 실제 운용해보고 필요하면 trust:untrusted로 바꿀 것.
  sketchup:
    command: "uv"
    args: ["run", "--directory", "C:\\hermes-projects\\vendor\\sketchup-mcp", "sketchup-mcp"]
    trust: full

  # --- 렌더 (3ds Max + V-Ray) ---
  # cl0nazepamm/3dsmax-mcp — 네이티브 C++ 브리지, uv로 실행.
  #
  # 실측 정정 (2026-08-28): 원본은 151개(기본 `full` 프로파일)이지 예전 추정 "~24개"가
  # 아니다. MCP_TOOL_PROFILE=core 로 87개까지 먼저 깎는다 — render/render_automations
  # 모듈은 core에 없지만, 우리 렌더 경로가 쓰는 execute_maxscript(=execute 모듈)는 core에
  # 있어서 문제없다(render_scene은 애초에 Render Setup 설정을 무시해서 안 쓴다 —
  # maxscripts.py의 render_to_file_script 참고). 아래 tools.include 는 실제 조사로 이름을
  # 확인한 것만 넣었다 — "확인 안 됨"이라고 주석 붙은 건 클론 후 `hermes mcp list`로
  # 최종 확정할 것 (vendor/README.md 참고).
  max3d:
    command: "uv"
    args: ["run", "--directory", "C:\\hermes-projects\\vendor\\3dsmax-mcp", "3dsmax-mcp"]
    env:
      MCP_TOOL_PROFILE: "core"
    trust: untrusted   # create_object/delete_objects/transform_object 등 쓰기 도구가 섞여 있다
    tools:
      include:
        # 씬 조회 (core: query_scene, hierarchy 모듈 — 확인됨)
        - "query_scene"
        - "get_hierarchy"
        - "get_object_properties"
        # 오브젝트 조작 (core: objects/transform/selection/visibility/clone 모듈 — 확인됨)
        - "create_object"
        - "delete_objects"
        - "set_object_property"
        - "transform_object"
        - "select_objects"
        - "set_visibility"
        - "clone_objects"
        # 재질 (core: materials/material_ops 모듈 — 확인됨)
        - "get_materials"
        - "assign_material"
        - "set_material_property"
        - "set_material_properties"
        - "create_material_from_textures"
        - "smart_import"
        # 뷰포트 캡처 (core: viewport 모듈 — 확인됨. render_scene은 full 전용이라 제외)
        - "capture_viewport"
        - "capture_multi_view"
        # 외부 .max 파일 (core: file_access 모듈 — 확인됨)
        - "inspect_max_file"
        - "merge_from_file"
        # 스크립팅 — 우리 렌더 경로의 실제 실행 통로 (core: execute 모듈 — 확인됨)
        - "execute_maxscript"
        # 아래는 예전 추정 목록에 있었지만 이번 조사로 실명 확인이 안 된 것들이다.
        # 존재하지 않는 이름을 include 해도 에러는 안 나고 그냥 아무것도 안 걸린다 —
        # 해가 없어 남겨두되, 대상 환경에서 `hermes mcp list` 로 실제 이름을 확인해서
        # 정리할 것.
        # - "get_bridge_status"   # 미확인 — bridge 모듈(core)에 있을 것으로 추정
        # - "get_session_context" # 미확인 — session_context 모듈(core)에 있을 것으로 추정

  # --- 일정 (Google Calendar) ---
  # nspady/google-calendar-mcp — npx로 실행, OAuth 자격증명 필요(env.example 참고).
  # ENABLED_TOOLS는 이 서버 자체의 필터(선택) — Hermes의 tools.include와 별개로 존재한다.
  #
  # Windows 주의 (2026-08-28 실측): command를 `npx`로 두면 실패한다. Hermes는 MCP stdio 서버를
  # 셸 없이 subprocess로 띄우고, Windows의 subprocess는 PATHEXT를 적용하지 않아 확장자 없는
  # `npx`를 찾지 못한다:
  #     npx      -> FileNotFoundError: [WinError 2] 지정된 파일을 찾을 수 없습니다
  #     npx.cmd  -> OK
  # 그래서 Windows에서는 반드시 `npx.cmd`. `-y`는 최초 실행 시 설치 확인 프롬프트를 건너뛰기
  # 위한 것으로, TTY가 없는 게이트웨이 환경에서 멈추지 않게 한다.
  # (Linux/macOS에서는 `npx`, args는 `["-y", ...]` 그대로 두면 된다.)
  calendar:
    command: "npx.cmd"
    args: ["-y", "@cocal/google-calendar-mcp"]
    env:
      GOOGLE_OAUTH_CREDENTIALS: "C:\\hermes-projects\\secrets\\gcp-oauth.keys.json"
    tools:
      exclude: ["manage-accounts"]  # 폰/워치 흐름에서 계정 관리는 불필요

  # --- 이미지 생성 (comfyui-bridge, 이 리포 신규 구현) ---
  # 로컬 ComfyUI의 REST API(127.0.0.1:8188)를 대신 호출하는 좁은 MCP 서버 —
  # generate_image 함수 하나만 노출한다. platform_toolsets 등록 불필요(MCP 서버는
  # 그걸로 안 걸림, calendar와 동일). ComfyUI 자체는 별도로 미리 켜둬야 한다:
  # comfy launch --background (docs/backend-new-machine-setup.md §3 참고).
  comfyui-bridge:
    command: "comfyui-bridge"
    trust: full

  # --- 사용자용 문서 생성 (file-export, 이 리포 신규 구현) ---
  # 로컬 디스크에 텍스트 파일 하나 쓰는 좁은 MCP 서버 — export_file 함수 하나만
  # 노출한다. write_file(Hermes 내장)과 달리 upload-server가 폰에 서빙하는 위치에
  # 저장해서, 리포트/정리/요약을 만들 때 폰에서 다운로드/미리보기가 가능해진다
  # (설계 문서: docs/superpowers/specs/2026-08-29-file-export-design.md).
  file-export:
    command: "file-export"
    trust: full

# API 서버 설정은 .env 우선이지만 config.yaml에도 둘 수 있다 (env가 항상 이긴다).
# env.example 을 이미 채웠다면 이 블록은 생략해도 된다.
# gateway:
#   api_server:
#     enabled: true
#     port: 8642
#     host: 0.0.0.0
#     key: change-me-generate-a-long-random-string
#     max_concurrent_runs: 10   # 0이면 무제한. 렌더처럼 오래 걸리는 run이 겹치면 올린다.
